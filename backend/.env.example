# DrainCast backend — environment template.
# Copy to .env and adjust as needed; every value has a working default.

# Flask server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0

# CORS: comma-separated list of allowed origins ("*" for development).
# The React demo does not call this API — this matters only when wiring
# a real deployment.
CORS_ORIGINS=*

# Optional: override the data directory (defaults to ./data).
# DRAINCAST_DATA_DIR=/absolute/path/to/data
